diff -ruN --strip-trailing-cr '--exclude=obj' '--exclude=bin' baseline/kern/init/lab3_module1_probe.S code/kern/init/lab3_module1_probe.S
--- baseline/kern/init/lab3_module1_probe.S	1970-01-01 08:00:00.000000000 +0800
+++ code/kern/init/lab3_module1_probe.S	2026-11-03 15:24:21.055687358 +0800
@@ -0,0 +1,21 @@
+    .text
+    .align 2
+    .globl lab3_module1_probe
+    .type lab3_module1_probe, @function
+lab3_module1_probe:
+    addi sp, sp, -16
+    sd ra, 8(sp)
+    li ra, 0x13579
+    li t0, 0x2468a
+    li a0, 0x3579b
+    .balign 4
+    .globl lab3_module1_breakpoint
+lab3_module1_breakpoint:
+    .4byte 0x00100073
+    .globl lab3_module1_resume
+lab3_module1_resume:
+    addi a0, a0, 1
+    ld ra, 8(sp)
+    addi sp, sp, 16
+    ret
+    .size lab3_module1_probe, .-lab3_module1_probe
